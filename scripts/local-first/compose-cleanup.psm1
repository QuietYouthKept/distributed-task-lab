
if ([string]::IsNullOrWhiteSpace($env:TASKLAB_ARTIFACT_ROOT)) { $env:TASKLAB_ARTIFACT_ROOT = Join-Path ([System.IO.Path]::GetTempPath()) 'distributed-task-lab' }
$TaskLabArtifactRoot = [System.IO.Path]::GetFullPath($env:TASKLAB_ARTIFACT_ROOT)
Set-StrictMode -Version Latest

function Get-ScopedComposeCleanupPlan {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$ComposeProject,
        [Parameter(Mandatory)][string]$ComposeEnvFile,
        [Parameter(Mandatory)][string]$ComposeFile,
        [switch]$StopServices,
        [switch]$RemoveContainersAndNetwork,
        [switch]$DeleteEphemeralSecrets
    )
    if ($ComposeProject -notmatch '^tasklab-local-first-(?<run>[0-9]{8}t[0-9]{6}[pm][0-9]{4})$') { throw 'Compose project is not an exact TaskLab local-first Run ID.' }
    $runId = $Matches.run
    $envPath = [System.IO.Path]::GetFullPath($ComposeEnvFile)
    if (-not $envPath.StartsWith('E:\',[System.StringComparison]::OrdinalIgnoreCase)) { throw 'Compose env file must be under E:.' }
    if (-not (Test-Path -LiteralPath $envPath -PathType Leaf)) { throw 'Compose env file does not exist.' }
    $values = @{}
    foreach ($line in Get-Content -LiteralPath $envPath) {
        if ($line -match '^([A-Z0-9_]+)=(.*)$') { $values[$Matches[1]] = $Matches[2] }
    }
    if ($values.COMPOSE_PROJECT_NAME -cne $ComposeProject) { throw 'Compose env project name does not exactly match the requested project.' }
    $expectedNetwork = "$ComposeProject-core"
    $expectedPostgresVolume = "$ComposeProject-postgres"
    $expectedMinioVolume = "$ComposeProject-minio"
    foreach ($entry in @(@('TASKLAB_NETWORK_NAME',$expectedNetwork),@('TASKLAB_POSTGRES_VOLUME',$expectedPostgresVolume),@('TASKLAB_MINIO_VOLUME',$expectedMinioVolume))) {
        if ($values[$entry[0]] -cne $entry[1]) { throw "Compose env value $($entry[0]) is not scoped to this Run ID." }
    }
    $secretDir = [System.IO.Path]::GetFullPath(([string]$values.TASKLAB_SECRET_DIR).Replace('/','\'))
    $secretRoot = $(Join-Path $TaskLabArtifactRoot 'production-readiness\secrets\')
    if (-not $secretDir.StartsWith($secretRoot,[System.StringComparison]::OrdinalIgnoreCase)) { throw 'Ephemeral secrets directory is outside the dedicated E: secret root.' }
    $secretLeaf = Split-Path -Leaf $secretDir
    $normalizedSecretLeaf = $secretLeaf.ToLowerInvariant().Replace('p0-runtime-','').Replace('+','p').Replace('-','m')
    if ($normalizedSecretLeaf -cne $runId) { throw 'Secret directory does not belong to the requested Compose Run ID.' }
    $composeFullPath = [System.IO.Path]::GetFullPath($ComposeFile)
    if (-not $composeFullPath.StartsWith($(Join-Path $TaskLabArtifactRoot 'production-readiness\worktree\'),[System.StringComparison]::OrdinalIgnoreCase) -or -not (Test-Path -LiteralPath $composeFullPath -PathType Leaf)) { throw 'Compose file must be the existing file in the dedicated E: worktree.' }

    $allowedFiles = @(
        'postgres-superuser-password','tasklab-migrator-password','tasklab-api-password','tasklab-worker-password',
        'minio-root-user','minio-root-password','artifact-s3-access-key','artifact-s3-secret-key','gateway-api-key','api-cursor-signing-key',
        'migrator-database-url','api-database-url','worker-database-url','compose.env',
        'tls\test-ca.key','tls\test-ca.crt','tls\test-ca.srl','tls\ca-extensions.cnf','tls\identity.key','tls\identity.crt','tls\identity-extensions.cnf',
        'tls\api.key','tls\api.crt','tls\api-extensions.cnf','tls\identity\identity.crt','tls\identity\identity.key',
        'tls\api\api.crt','tls\api\api.key','tls\api\test-ca.crt'
    )
    $unknownSecretFiles = @()
    if (Test-Path -LiteralPath $secretDir -PathType Container) {
        $secretEntries = @(Get-ChildItem -LiteralPath $secretDir -Recurse -Force)
        if (@($secretEntries | Where-Object { $_.Attributes -band [System.IO.FileAttributes]::ReparsePoint }).Count -gt 0) { throw 'Refusing cleanup of a secret directory containing reparse points.' }
        foreach ($directory in @($secretEntries | Where-Object { $_.PSIsContainer })) {
            $relativeDirectory = [System.IO.Path]::GetRelativePath($secretDir,$directory.FullName).Replace('/','\')
            if ($relativeDirectory -notin @('tls','tls\identity','tls\api')) { $unknownSecretFiles += $relativeDirectory }
        }
        foreach ($file in @($secretEntries | Where-Object { -not $_.PSIsContainer })) {
            $relative = [System.IO.Path]::GetRelativePath($secretDir,$file.FullName).Replace('/','\')
            if ($relative -notin $allowedFiles) { $unknownSecretFiles += $relative }
        }
    }
    if ($DeleteEphemeralSecrets -and $unknownSecretFiles.Count -gt 0) { throw 'Refusing to delete a secret directory containing files not generated by the current provisioner.' }
    return [pscustomobject]@{
        run_id=$runId; project=$ComposeProject; env_file=$envPath; secret_directory=$secretDir; compose_file=$composeFullPath
        expected_network=$expectedNetwork; expected_volumes=@($expectedPostgresVolume,$expectedMinioVolume)
        stop_services=[bool]$StopServices; remove_containers_and_network=[bool]$RemoveContainersAndNetwork
        retain_data_volumes=$true; delete_ephemeral_secrets=[bool]$DeleteEphemeralSecrets
        unknown_secret_files=@($unknownSecretFiles); preserve_evidence=$true; dry_run=$true
    }
}

function Invoke-ScopedComposeCleanup {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]$Plan,
        [Parameter(Mandatory)][scriptblock]$Executor,
        [string]$ConfirmRunId,
        [switch]$Apply
    )
    $calls = [System.Collections.Generic.List[object]]::new()
    $project = [string]$Plan.project
    $containerArgs = @('ps','-a','--filter',"label=com.docker.compose.project=$project",'--format','{{.ID}}|{{.Label "com.docker.compose.project"}}')
    $containerOutput = & $Executor @containerArgs
    if ($LASTEXITCODE -notin @(0,$null)) { throw 'Could not verify Compose container ownership.' }
    $containers = @($containerOutput | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) })
    foreach ($row in $containers) { if ([string]$row -notmatch "^[^|]+\|$([regex]::Escape($project))$") { throw "Docker container labels do not prove exact project ownership: $row" } }
    $networkArgs = @('network','ls','--filter',"label=com.docker.compose.project=$project",'--format','{{.Name}}|{{.Label "com.docker.compose.project"}}')
    $networkOutput = & $Executor @networkArgs
    if ($LASTEXITCODE -notin @(0,$null)) { throw 'Could not verify Compose network ownership.' }
    $networks = @($networkOutput | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) })
    foreach ($row in $networks) { if ([string]$row -notmatch "^$([regex]::Escape([string]$Plan.expected_network))\|$([regex]::Escape($project))$") { throw 'Network labels/name do not prove exact Run ID ownership.' } }
    $volumeArgs = @('volume','ls','--filter',"label=com.docker.compose.project=$project",'--format','{{.Name}}|{{.Label "com.docker.compose.project"}}')
    $volumeOutput = & $Executor @volumeArgs
    if ($LASTEXITCODE -notin @(0,$null)) { throw 'Could not verify Compose volume ownership.' }
    $volumes = @($volumeOutput | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) })
    foreach ($row in $volumes) {
        $parts = ([string]$row).Split('|')
        if ($parts.Count -ne 2 -or $parts[1] -cne $project -or $parts[0] -notin @($Plan.expected_volumes)) { throw 'Volume labels/name do not match the known retained volumes for this Run ID.' }
    }
    $calls.Add([pscustomobject]@{action='inspect';containers=$containers.Count;networks=$networks.Count;volumes=$volumes.Count})
    if (-not $Apply) { return [pscustomobject]@{status='PLAN_ONLY';executed=$false;plan=$Plan;inspection=$calls;volumes_removed=0} }
    if ($ConfirmRunId -cne [string]$Plan.run_id) { throw 'Apply requires -ConfirmRunId to exactly match the Compose Run ID.' }
    if (-not $Plan.stop_services -and -not $Plan.remove_containers_and_network -and -not $Plan.delete_ephemeral_secrets) { throw 'Apply requires at least one explicit cleanup action.' }
    if ($Plan.stop_services) {
        $stopArgs = @('compose','--project-name',$project,'--env-file',[string]$Plan.env_file,'-f',[string]$Plan.compose_file,'stop')
        $null = & $Executor @stopArgs
        if ($LASTEXITCODE -notin @(0,$null)) { throw 'Scoped service stop failed; evidence and all data volumes were preserved.' }
        $calls.Add([pscustomobject]@{action='stop-services';exit_code=0})
    }
    if ($Plan.remove_containers_and_network) {
        $downArgs = @('compose','--project-name',$project,'--env-file',[string]$Plan.env_file,'-f',[string]$Plan.compose_file,'down','--remove-orphans')
        $null = & $Executor @downArgs
        if ($LASTEXITCODE -notin @(0,$null)) { throw 'Scoped container/network removal failed; data volumes and evidence were preserved.' }
        $calls.Add([pscustomobject]@{action='remove-containers-network';exit_code=0;volumes_removed=0})
    }
    if ($Plan.delete_ephemeral_secrets) {
        if (-not (Test-Path -LiteralPath $Plan.secret_directory -PathType Container)) { throw 'Secret directory does not exist; refusing ambiguous cleanup.' }
        $null = Remove-Item -LiteralPath $Plan.secret_directory -Recurse -Force -WhatIf:$false
        $calls.Add([pscustomobject]@{action='delete-run-scoped-ephemeral-secrets';exit_code=0})
    }
    return [pscustomobject]@{status='APPLIED';executed=$true;plan=$Plan;inspection=$calls;volumes_removed=0;evidence_preserved=$true}
}

Export-ModuleMember -Function Get-ScopedComposeCleanupPlan,Invoke-ScopedComposeCleanup
