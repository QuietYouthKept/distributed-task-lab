# Local development only. Do not reuse these example values in a deployment.
APP_PROFILE=development
API_TOKEN=replace-with-a-local-api-token
ADMIN_TOKEN=replace-with-a-distinct-local-admin-token
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tasklab?sslmode=disable
RAG_DOC_DIR=examples/docs
RAG_ARTIFACT_DIR=artifacts/index
EVAL_BACKEND=deterministic
# Required when EVAL_BACKEND=gateway; production requires HTTPS and an API key.
EVAL_GATEWAY_URL=
EVAL_GATEWAY_PROFILE=
EVAL_GATEWAY_API_KEY=
# Optional Wave 4 cross-replica admission candidate. Defaults off; when enabled,
# choose and approve an explicit shared quota and outage policy first.
API_SHARED_RATE_LIMIT_ENABLED=false
API_SHARED_RATE_LIMIT_RATE_PER_SECOND=
API_SHARED_RATE_LIMIT_BURST=
API_SHARED_RATE_LIMIT_FAILURE_MODE=
API_SHARED_RATE_LIMIT_HASH_KEY=
# Optional expiring cursor key-ring candidate. Defaults off to preserve v1 tokens.
# When enabled, set active key ID/key, TTL, and bounded previous/legacy overlap.
API_CURSOR_KEY_RING_ENABLED=false
API_CURSOR_ACTIVE_KEY_ID=
API_CURSOR_ACTIVE_KEY=
API_CURSOR_TTL=
API_CURSOR_PREVIOUS_KEYS=
API_CURSOR_V1_LEGACY_KEY=
API_CURSOR_V1_ACCEPT_UNTIL=
