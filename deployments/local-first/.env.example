# Set this to the E: directory emitted by scripts/local-first/provision.ps1.
TASKLAB_SECRET_DIR=E:/replace/with/provisioned/secrets
TASKLAB_IDENTITY_TLS_DIR=E:/replace/with/provisioned/tls/identity
TASKLAB_API_TLS_DIR=E:/replace/with/provisioned/tls/api

# Use a verified immutable official registry reference (tag@sha256:digest).
POSTGRES_IMAGE=postgres:16-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
MINIO_IMAGE=replace-with-verified-official-minio-tag@sha256:replace-with-registry-digest

API_HOST_PORT=18443
IDENTITY_HOST_PORT=18444
GOPROXY=https://proxy.golang.org,direct
