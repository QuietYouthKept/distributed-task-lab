FROM golang:1.26.9-alpine@sha256:cdfd4fe2da6b225d8b40c6b7a105736e548e83ff56d5d8f9394446eeb5eb84e0 AS builder

ARG GOPROXY=https://proxy.golang.org,direct
ARG TARGETOS=linux
ARG TARGETARCH
ENV GOPROXY=${GOPROXY}

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -buildvcs=false -o /oidc-fixture ./cmd/oidc-fixture

FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.title="distributed-task-lab-local-oidc-fixture" \
      org.opencontainers.image.source="https://github.com/QuietYouthKept/distributed-task-lab" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.description="Local-only HTTPS JWKS and fixed-role token fixture; not a production identity provider"
RUN apk add --no-cache ca-certificates \
    && addgroup -S tasklab \
    && adduser -S -G tasklab -h /app tasklab
COPY --from=builder --chown=tasklab:tasklab /oidc-fixture /oidc-fixture
USER tasklab
EXPOSE 8443
ENTRYPOINT ["/oidc-fixture"]
