FROM golang:1.26.9-alpine@sha256:cdfd4fe2da6b225d8b40c6b7a105736e548e83ff56d5d8f9394446eeb5eb84e0 AS builder

ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /worker ./cmd/worker

FROM alpine:3.19
RUN apk add --no-cache ca-certificates \
    && addgroup -S tasklab \
    && adduser -S -G tasklab -h /app tasklab
COPY --from=builder --chown=tasklab:tasklab /worker /worker

# Real RAG ingestion reads markdown from RAG_DOC_DIR and writes JSONL artifacts
# to RAG_ARTIFACT_DIR. Copy the example docs and create a writable artifacts dir
# so a controlled object_key task can resolve a development fixture.
COPY --from=builder --chown=tasklab:tasklab /app/examples/docs /app/examples/docs
RUN mkdir -p /app/artifacts/index \
    && chown -R tasklab:tasklab /app
ENV RAG_DOC_DIR=/app/examples/docs \
    RAG_ARTIFACT_DIR=/app/artifacts/index

USER tasklab
EXPOSE 9091

CMD ["/worker"]
