{
  "openapi": "3.1.0",
  "info": {
    "title": "distributed-task-lab API",
    "version": "1.0.0",
    "description": "Stable v1 contract for the single-tenant task queue laboratory."
  },
  "servers": [{"url": "/"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/tasks": {
      "get": {"operationId": "listTasks", "x-required-role": "reader", "parameters": [
        {"name": "status", "in": "query", "schema": {"$ref": "#/components/schemas/TaskStatus"}},
        {"name": "type", "in": "query", "schema": {"$ref": "#/components/schemas/TaskType"}},
        {"name": "queue", "in": "query", "schema": {"type": "string", "maxLength": 128}},
        {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}},
        {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 2048}}
      ], "responses": {"200": {"description": "Cursor page with tasks, has_more and an optional next_cursor"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "422": {"$ref": "#/components/responses/InvalidArgument"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}},
      "post": {"operationId": "createTask", "x-required-role": "operator", "parameters": [
        {"name": "Idempotency-Key", "in": "header", "required": false, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}
      ], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateTaskRequest"}}}},
      "responses": {"201": {"description": "Created"}, "400": {"$ref": "#/components/responses/MalformedRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "422": {"$ref": "#/components/responses/InvalidArgument"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}}
    },
    "/v1/tasks/{id}": {"get": {"operationId": "getTask", "x-required-role": "reader", "parameters": [{"$ref": "#/components/parameters/TaskID"}], "responses": {"200": {"description": "Task"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/v1/tasks/{id}/events": {"get": {"operationId": "getTaskEvents", "x-required-role": "reader", "parameters": [{"$ref": "#/components/parameters/TaskID"}], "responses": {"200": {"description": "Task events"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/v1/tasks/{id}/cancel": {"post": {"operationId": "cancelTask", "x-required-role": "operator", "parameters": [{"$ref": "#/components/parameters/TaskID"}], "requestBody": {"$ref": "#/components/requestBodies/OptionalReason"}, "responses": {"200": {"description": "Cancelled"}, "400": {"$ref": "#/components/responses/MalformedRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/v1/tasks/{id}/requeue": {"post": {"operationId": "requeueTask", "x-required-role": "operator", "parameters": [{"$ref": "#/components/parameters/TaskID"}], "requestBody": {"$ref": "#/components/requestBodies/OptionalReason"}, "responses": {"200": {"description": "Requeued"}, "400": {"$ref": "#/components/responses/MalformedRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/v1/dlq": {"get": {"operationId": "listDLQ", "x-required-role": "operator", "responses": {"200": {"description": "Dead-letter tasks"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/v1/stats": {"get": {"operationId": "getStats", "x-required-role": "operator", "responses": {"200": {"description": "Task counts"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/v1/metrics": {"get": {"operationId": "getMetrics", "x-required-role": "operator", "responses": {"200": {"description": "Prometheus metrics", "content": {"text/plain": {"schema": {"type": "string"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "429": {"$ref": "#/components/responses/RateLimited"}}}},
    "/v1/queues": {"get": {"operationId": "listQueues", "x-required-role": "operator", "responses": {"200": {"description": "Queues"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/v1/queues/{name}": {"put": {"operationId": "setQueueConfig", "x-required-role": "admin", "parameters": [{"$ref": "#/components/parameters/QueueName"}], "requestBody": {"required": false, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QueueConfigRequest"}}}}, "responses": {"200": {"description": "Configured"}, "400": {"$ref": "#/components/responses/MalformedRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "422": {"$ref": "#/components/responses/InvalidArgument"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/v1/queues/{name}/pause": {"post": {"operationId": "pauseQueue", "x-required-role": "admin", "parameters": [{"$ref": "#/components/parameters/QueueName"}], "responses": {"200": {"description": "Paused"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/v1/queues/{name}/resume": {"post": {"operationId": "resumeQueue", "x-required-role": "admin", "parameters": [{"$ref": "#/components/parameters/QueueName"}], "responses": {"200": {"description": "Resumed"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/v1/effects": {"get": {"operationId": "listUnresolvedEffects", "x-required-role": "operator", "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100}}], "responses": {"200": {"description": "Unresolved effect records for operator reconciliation"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/v1/effects/{id}/resolve": {"post": {"operationId": "resolveEffectManually", "x-required-role": "admin", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1, "maxLength": 1024}}}}}}, "responses": {"200": {"description": "Manually resolved and audited"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}, "429": {"$ref": "#/components/responses/RateLimited"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "parameters": {
      "TaskID": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
      "QueueName": {"name": "name", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 128}}
    },
    "requestBodies": {
      "OptionalReason": {"required": false, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "properties": {"reason": {"type": "string"}}}}}}
    },
    "schemas": {
      "TaskStatus": {"type": "string", "enum": ["pending", "running", "success", "failed", "dlq"]},
      "TaskType": {"type": "string", "enum": ["rag_ingestion", "eval", "benchmark", "strategy_replay", "payment", "notification"]},
      "PayloadEnvelope": {"type": "object", "additionalProperties": false, "required": ["version", "kind", "data"], "properties": {"version": {"type": "string"}, "kind": {"type": "string"}, "data": {"type": "object"}}},
      "CreateTaskRequest": {"type": "object", "additionalProperties": false, "required": ["type", "payload"], "properties": {
        "type": {"$ref": "#/components/schemas/TaskType"}, "queue": {"type": "string", "maxLength": 128}, "payload": {"$ref": "#/components/schemas/PayloadEnvelope"}, "priority": {"type": "integer"}, "max_attempts": {"type": "integer", "minimum": 0}, "timeout_seconds": {"type": "integer", "minimum": 0}, "retry_delay_seconds": {"type": "integer", "minimum": 0}, "retry_max_delay_seconds": {"type": "integer", "minimum": 0}, "retry_backoff_multiplier": {"type": "number", "minimum": 0}, "retry_jitter": {"type": "boolean"}, "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256}
      }},
      "QueueConfigRequest": {"type": "object", "additionalProperties": false, "properties": {"max_concurrency": {"type": "integer", "minimum": 0}, "rate_limit_per_second": {"type": "number", "minimum": 0}, "burst": {"type": "integer", "minimum": 0}, "aging_after_seconds": {"type": "integer", "minimum": 0}, "aging_priority_boost": {"type": "integer", "minimum": 0}}},
      "APIError": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}},
      "ErrorResponse": {"type": "object", "additionalProperties": false, "required": ["error", "request_id"], "properties": {"error": {"$ref": "#/components/schemas/APIError"}, "request_id": {"type": "string"}}}
    },
    "responses": {
      "MalformedRequest": {"description": "Malformed JSON or request framing", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "InvalidArgument": {"description": "Valid request with invalid domain values", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Unauthorized": {"description": "Authentication required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Forbidden": {"description": "Authenticated principal lacks the required role", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "RateLimited": {"description": "Authenticated principal exceeded the process-local ingress quota; Retry-After is present", "headers": {"Retry-After": {"schema": {"type": "integer", "minimum": 1}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "NotFound": {"description": "Resource not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Conflict": {"description": "State conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Unavailable": {"description": "Database temporarily unavailable", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
    }
  }
}
